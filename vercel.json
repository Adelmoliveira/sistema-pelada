{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "crons": [
    {
      "path": "/cron/payment-reminders",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/cron/process-notification-outbox",
      "schedule": "0 13 * * *"
    }
  ]
}
